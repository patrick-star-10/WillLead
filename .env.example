VITE_SIGNAL_EMITTER_ADDRESS=
VITE_REACTIVE_LISTENER_ADDRESS=
VITE_ORIGIN_RPC_URL=
VITE_ORIGIN_CHAIN_ID=
VITE_ORIGIN_CHAIN_NAME=
VITE_DESTINATION_RPC_URL=
VITE_DESTINATION_CHAIN_ID=
VITE_DESTINATION_CHAIN_NAME=
VITE_REACTIVE_RPC_URL=
VITE_REACTIVE_CHAIN_ID=
VITE_REACTIVE_CHAIN_NAME=
VITE_CALLBACK_PROXY=
VITE_AUTHORIZED_RVM_ID=
