OWNER_PRIVATE_KEY=

ORIGIN_RPC_URL=
DESTINATION_RPC_URL=
REACTIVE_RPC_URL=

# Replace with any Reactive-supported source/destination chain ids.
# Current frontend defaults know: 11155111 (Ethereum Sepolia), 84532 (Base Sepolia),
# 421614 (Arbitrum Sepolia), 11155420 (OP Sepolia), 80002 (Polygon Amoy).
ORIGIN_CHAIN_ID=84532
DESTINATION_CHAIN_ID=11155111
REACTIVE_CHAIN_ID=5318007
ORIGIN_CHAIN_NAME=
DESTINATION_CHAIN_NAME=
REACTIVE_CHAIN_NAME=

CALLBACK_PROXY=
AUTHORIZED_RVM_ID=
# Set AUTHORIZED_RVM_ID to the EOA address that deploys the Reactive listener and destination wallet.
# This address is also the ReactVM ID used by sync-listener-subscription.sh to verify subscriptions.

WILLLEAD_WALLET=
WILLLEAD_WALLET_FACTORY=
WILLLEAD_SIGNAL_EMITTER=
WILLLEAD_REACTIVE_LISTENER=

